# Frontend Environment Configuration for Premium Watch Store

# API Configuration
REACT_APP_API_URL=http://localhost:5000/api

# App Configuration
REACT_APP_NAME=Premium Watch Store
REACT_APP_VERSION=1.0.0

# Payment Gateway Configuration (Public Keys)
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
REACT_APP_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Google Analytics (Optional)
REACT_APP_GA_TRACKING_ID=GA_MEASUREMENT_ID

# Social Media Links (Optional)
REACT_APP_FACEBOOK_URL=https://facebook.com/watchstore
REACT_APP_INSTAGRAM_URL=https://instagram.com/watchstore
REACT_APP_TWITTER_URL=https://twitter.com/watchstore

# Support Contact
REACT_APP_SUPPORT_EMAIL=support@watchstore.com
REACT_APP_SUPPORT_PHONE=+91 9876543210

# Features Toggle (Optional)
REACT_APP_ENABLE_DARK_MODE=true
REACT_APP_ENABLE_REVIEWS=true
REACT_APP_ENABLE_WISHLIST=true
REACT_APP_ENABLE_COMPARE=true
