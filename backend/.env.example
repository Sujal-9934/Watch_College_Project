# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=5000

# Browser origins. CORS_ORIGIN accepts a comma-separated list.
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# MySQL (use the managed database host and credentials in production)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=watch_store

# Use two different random secrets (at least 32 characters each) in production.
JWT_SECRET=replace_with_a_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_random_secret
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
JWT_COOKIE_EXPIRE=7
# For a cross-site frontend/API deployment set this to none; production cookies are secure.
COOKIE_SAME_SITE=lax

# Required for email verification, OTP login, and password resets.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_smtp_app_password
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Watch Store

# Optional: required only when enabling Razorpay checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional settings
BCRYPT_ROUNDS=12
API_BASE_URL=
# On Render, set this to the persistent disk path (for example /var/data/uploads).
UPLOAD_DIR=

# Only for the one-time `npm run create-admin` command; remove after use.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional account setup / local smoke-test tools (not needed by the web service).
SELLER_EMAIL=
SELLER_PASSWORD=
SELLER_FIRST_NAME=
SELLER_LAST_NAME=
TEST_EMAIL=
TEST_PASSWORD=
TEST_OTP=
VERIFY_EMAIL=
VERIFY_PASSWORD=
